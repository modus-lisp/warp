;;;; t/ask-text.lisp -- a prompt item on a consumer whose host has a keyboard: asked for, run with what comes back.
;;;;   sbcl --non-interactive --load t/ask-text.lisp
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(handler-bind ((warning #'muffle-warning))
  (let ((*standard-output* (make-broadcast-stream))) (asdf:load-system :warp)))
(defpackage #:warp-ask-test (:use #:cl #:warp))
(in-package #:warp-ask-test)
(defvar *fails* 0)
(defun ok (name pred) (format t "~&  ~:[FAIL~;ok  ~] ~a~%" pred name) (unless pred (incf *fails*)))

(defclass test-consumer (warp::consumer) ())
(defmethod warp::apply-deltas ((c test-consumer) deltas) deltas)

(defstruct setting name (value ""))
(define-presentation-key setting (s) (setting-name s))
(defvar *set* '())
(define-command (set-key :arg-type setting :label "set the key" :prompt "API key" :secret t
                         :current (lambda (s) (setting-value s)))
    (s invoker value)
  (setf (setting-value s) value)
  (push value *set*))

(let* ((s (make-setting :name "key" :value "old"))
       (asked '())
       (c (make-instance 'test-consumer :ask-text (lambda (&rest args) (push args asked))))
       (p (make-presentation :key "key" :type 'setting :object s)))
  (open-menu c p (list (find-command 'set-key)))
  (let* ((item (find :prompt (getf (consumer-menu c) :items) :key #'warp::mi-kind))
         (ip (make-presentation :key "item" :type 'warp::menu-item :object item)))
    (ok "the menu offers the prompt" item)
    (on-gesture c :tap ip)
    (let ((a (first asked)))
      (ok "the tap asks the host for text" (= 1 (length asked)))
      (ok "with the prompt's label" (equal (getf a :label) "API key"))
      (ok "what is set now" (equal (getf a :current) "old"))
      (ok "and that it is a secret" (eq (getf a :secret) t))
      (ok "nothing run yet: the text has not come back" (null *set*))
      (ok "the menu is closed" (null (consumer-menu c)))
      (funcall (getf a :done) "sk-123")
      (ok "the text, when it comes, runs the command with it" (and (equal *set* '("sk-123"))
                                                                  (equal (setting-value s) "sk-123"))))))
;; a consumer with no keyboard: as before, the tap only closes the menu
(let* ((s (make-setting :name "k2"))
       (c (make-instance 'test-consumer))
       (p (make-presentation :key "k2" :type 'setting :object s)))
  (setf *set* '())
  (open-menu c p (list (find-command 'set-key)))
  (on-gesture c :tap (make-presentation :key "i" :type 'warp::menu-item
                                        :object (find :prompt (getf (consumer-menu c) :items) :key #'warp::mi-kind)))
  (ok "no host keyboard: nothing asked, nothing run, the menu closed" (and (null *set*) (null (consumer-menu c)))))
(format t "~&~:[ALL OK~;~:*~D FAILED~]~%" (and (plusp *fails*) *fails*))
